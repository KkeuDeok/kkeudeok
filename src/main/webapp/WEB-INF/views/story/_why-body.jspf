<%@ page pageEncoding="UTF-8" %>

<%
    String[][] whyTitles = {
        {"sad",   "{c}는 왜 슬퍼졌을까?"},
        {"angry", "{c}는 왜 화가 났을까?"},
        {"happy", "{c}는 왜 기뻐졌을까?"},
        {"surprise", "{c}는 왜 놀랐을까?"}
    };
    String whyTitle = whyTitles[0][1];
    for (String[] row : whyTitles) {
        if (row[0].equals(emo)) whyTitle = row[1];
    }

    String[][] whyCauses = {
        {"sad",   "길을 잃어서 무서워서", "sad"},
        {"angry", "내가 무너뜨려서", "angry"},
        {"happy", "선물을 받아서",          "happy"},
        {"surprise", "큰 소리가 나서", "surprise"}
    };
    String[] whyCause = whyCauses[0];
    for (String[] row : whyCauses) {
        if (row[0].equals(emo)) whyCause = row;
    }

    String[][] whyHints = {
        {"sad",   "그림 속 표정을 잘 봐. 무서워서 찡그린 얼굴일까, 졸려서 하품하는 얼굴일까?"},
        {"angry", "그림 속 표정을 잘 봐. 속상해서 찌푸린 얼굴일까, 졸려서 하품하는 얼굴일까?"},
        {"happy", "그림 속 표정을 잘 봐. 좋아서 웃는 얼굴일까, 졸려서 하품하는 얼굴일까?"},
        {"surprise", "그림 속 표정을 잘 봐. 놀라서 눈이 커진 얼굴일까, 졸려서 하품하는 얼굴일까?"}
    };
    String whyHint = whyHints[0][1];
    for (String[] row : whyHints) {
        if (row[0].equals(emo)) whyHint = row[1];
    }
%>

<h1 class="why-title"><%= whyTitle.replace("{c}", CHAR) %></h1>
<p class="why-sub">말로 해도 되고, 그림을 눌러도 돼</p>

<div class="why-cards">

    <a class="why-card<%= "cause".equals(whyPick) ? " is-pick" : "" %>" data-right href="/story/face?emo=<%= emo %>">
        <img class="ic" data-kd-char="<%= whyCause[2] %>" src="/img/char-tori-<%= whyCause[2] %>.png" alt="">
        <p class="nm"><%= whyCause[1] %></p>
        <span class="spk" aria-hidden="true"></span>
    </a>
    <a class="why-card<%= "other".equals(whyPick) ? " is-pick" : "" %>" data-wrong="other" href="/story/why?emo=<%= emo %>&wrong=other">
        <img class="ic" data-kd-char="sleepy" src="/img/char-tori-sleepy.png" alt="">
        <p class="nm">졸려서</p>
        <span class="spk" aria-hidden="true"></span>
    </a>
</div>

<p class="why-hint" hidden><%= whyHint %></p>
