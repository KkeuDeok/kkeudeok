<%@ page pageEncoding="UTF-8" %>

<%

    String[][] feelRecaps = {
        {"sad",      "{c}는 낯선 곳에서 길을 잃을 뻔해 눈물이 맺혔어요"},
        {"angry",    "{c}는 쌓아 올린 블록이 무너져 주먹을 꼭 쥐었어요"},
        {"happy",    "{c}는 깜짝 선물을 받고 깡충깡충 뛰었어요"},
        {"surprise", "{c}는 큰 소리에 눈이 동그래지고 어깨가 움찔했어요"}
    };
    String feelRecap = feelRecaps[0][1];
    for (String[] row : feelRecaps) {
        if (row[0].equals(emo)) feelRecap = row[1];
    }

    String[][] feelAll = {
        {"happy",    "기뻐요",   "마음이 콩콩 뛰어요", "기쁠 때는 입꼬리가 올라가."},
        {"sad",      "슬퍼요",   "가슴이 콕콕 아파요", "슬플 때는 눈썹이 아래로 처져."},
        {"angry",    "화나요",   "얼굴이 뜨거워져요", "화날 때는 눈썹이 뾰족해져."},
        {"surprise", "놀랐어요", "눈이 동그래져요",   "놀랄 때는 눈이 동그래져."}
    };

    int FEEL_CARD_COUNT = 3;

    java.util.List<String[]> feelCards = new java.util.ArrayList<String[]>();
    for (String[] c : feelAll) {
        feelCards.add(c);
    }
    for (int i = feelCards.size() - 1; i >= 0 && feelCards.size() > FEEL_CARD_COUNT; i--) {
        if (!feelCards.get(i)[0].equals(emo)) feelCards.remove(i);
    }
%>

<div class="feel-art"><img data-kd-char="neutral" src="/img/char-tori-neutral.png" alt=""></div>

<p class="feel-recap"><%= feelRecap.replace("{c}", CHAR) %></p>
<h1 class="feel-q"><%= "{c}는 지금 어떤 마음일까?".replace("{c}", CHAR) %></h1>

<div class="feel-cards">
    <%  for (String[] card : feelCards) {
            boolean right = card[0].equals(emo);
            String href = right ? "/story/why?emo=" + emo
                                : "/story/feel?emo=" + emo + "&wrong=" + card[0];

            String cls = "feel-card" + (card[0].equals(feelPick) ? " is-pick" : "");
    %>

    <a class="<%= cls %>"<%= right ? " data-right" : " data-wrong=\"" + card[0] + "\"" %>
       data-kd-key="<%= card[0] %>" data-trait="<%= card[3] %>" href="<%= href %>">
        <img class="ic" data-kd-char="<%= card[0] %>" src="/img/char-tori-<%= card[0] %>.png" alt="">
        <p class="nm"><%= card[1] %></p>
        <p class="ds"><%= card[2] %></p>
        <span class="spk" aria-hidden="true"></span>
    </a>
    <% } %>
</div>
