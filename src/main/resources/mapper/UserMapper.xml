<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace = 짝이 되는 자바 인터페이스의 전체 이름. id = 그 인터페이스의 메서드명.
     ⚠ 둘 중 하나라도 어긋나면 기동할 때 BindingException 이 난다.
     컬럼은 snake_case, DTO 는 camelCase — application.properties 의
     mybatis.configuration.map-underscore-to-camel-case=true 가 이어 준다. -->
<mapper namespace="kopo.kkeudeok.mapper.IUserMapper">

    <!-- ================= 회원가입 ================= -->

    <!-- 아이디 중복 확인.
         ⚠ MariaDB 의 IF() 대신 CASE WHEN 을 쓴다 — IF() 는 표준이 아니라
            테스트가 도는 H2 에서 문법 오류가 난다(2026-08-13에 실제로 깨졌다). -->
    <select id="getLoginIdExists" parameterType="UserDTO" resultType="UserDTO">
        SELECT CASE WHEN COUNT(member_id) > 0 THEN 'Y' ELSE 'N' END AS exists_yn
        FROM member
        WHERE login_id = #{loginId}
          AND deleted_at IS NULL
    </select>

    <!-- 이메일 중복 확인 — email 은 AES 암호문으로 들어온다 -->
    <select id="getEmailExists" parameterType="UserDTO" resultType="UserDTO">
        SELECT CASE WHEN COUNT(member_id) > 0 THEN 'Y' ELSE 'N' END AS exists_yn
        FROM member
        WHERE email = #{email}
          AND deleted_at IS NULL
    </select>

    <!-- 회원 저장. 컬럼은 실제 MariaDB 스키마 기준(2026-08-13 information_schema 확인).
         넣지 않는 컬럼은 DB 기본값으로 채워진다
           · parent_pin·phone·relation → NULL (온보딩·마이페이지에서 나중에 채운다)
           · created_at·updated_at     → CURRENT_TIMESTAMP
         ⚠ email 에 uq_member_email UNIQUE 가 걸려 있다. AES 는 IV 가 고정이라 같은 주소가
           항상 같은 암호문이 되므로 중복이 제대로 걸린다.
         ⚠ 시각은 NOW() 가 아니라 앱에서 받은 값을 쓴다 — VM 의 DB 시계가 어긋나 있다
           (UserService.insertUser 주석 참고). -->
    <insert id="insertUser" parameterType="UserDTO">
        INSERT INTO member (
            login_id,
            password,
            name,
            email,
            agree_service,
            agree_privacy,
            agree_sensitive,
            agreed_at,
            notify_weekly_report,
            notify_reminder,
            agree_marketing,
            created_at,
            updated_at
        ) VALUES (
            #{loginId},
            #{password},
            #{name},
            #{email},
            #{agreeService},
            #{agreePrivacy},
            #{agreeSensitive},
            #{agreedAt},
            #{notifyWeeklyReport},
            #{notifyReminder},
            #{agreeMarketing},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <!-- ================= 로그인 · 아이디 찾기 ================= -->

    <!-- 아이디·비밀번호가 맞는 회원 1명. 없으면 null.
         password 는 EncryptUtil.encHashSHA256 을 거친 해시로 들어온다. -->
    <select id="getLogin" parameterType="UserDTO" resultType="UserDTO">
        SELECT member_id, login_id, name, email
        FROM member
        WHERE login_id = #{loginId}
          AND password = #{password}
          AND deleted_at IS NULL
    </select>

    <!-- 이름·이메일이 맞는 회원 1명. email 은 AES 암호문. -->
    <select id="getFindId" parameterType="UserDTO" resultType="UserDTO">
        SELECT member_id, login_id, name, email
        FROM member
        WHERE name = #{name}
          AND email = #{email}
          AND deleted_at IS NULL
    </select>

    <!-- ================= 비밀번호 찾기 ================= -->

    <!-- 화면(find-pw-email.jsp)이 이메일만 받으므로 이메일로만 찾는다.
         메일 인증을 통과해야 여기까지 오므로 본인 확인은 끝난 상태다. -->
    <select id="getFindPwUser" parameterType="UserDTO" resultType="UserDTO">
        SELECT member_id, login_id, name, email
        FROM member
        WHERE email = #{email}
          AND deleted_at IS NULL
    </select>

    <!-- updated_at 은 ON UPDATE CURRENT_TIMESTAMP 라 두면 DB 가 알아서 올리지만,
         그 시계가 어긋나 있어 앱에서 받은 값으로 덮어쓴다. -->
    <update id="updatePassword" parameterType="UserDTO">
        UPDATE member
        SET password   = #{password},
            updated_at = #{updatedAt}
        WHERE login_id = #{loginId}
          AND deleted_at IS NULL
    </update>

    <!-- ================= 마이페이지 =================

         회원정보 화면에 뿌릴 한 명. 로그인한 본인이므로 비밀번호는 묻지 않는다.
         ⚠ password 는 뽑지 않는다 — 화면까지 내려갈 이유가 없는 값은 애초에 가져오지 않는다.
         phone·relation 은 아직 채우는 화면이 없어 NULL 일 수 있다(화면에서 빈 칸으로 보인다). -->
    <select id="getUserInfo" parameterType="UserDTO" resultType="UserDTO">
        SELECT member_id,
               login_id,
               name,
               email,
               phone,
               relation,
               notify_weekly_report,
               notify_reminder,
               agree_marketing
        FROM member
        WHERE login_id = #{loginId}
          AND deleted_at IS NULL
    </select>

    <!-- 회원정보 저장. 화면에 있는 칸만 바꾼다.
         · 이메일·아이디는 계정 식별자라 화면에서 수정 불가(readonly) → SET 에 넣지 않는다.
         · 비밀번호는 별도 흐름(비밀번호 변경)에서만 바꾼다.
         ⚠ phone·relation 은 빈 값이면 컨트롤러가 null 로 바꿔 보낸다 — 빈 문자열을 넣으면
           "값이 있는데 비어 있는" 상태가 돼 NULL 검사와 어긋난다. -->
    <update id="updateUserInfo" parameterType="UserDTO">
        UPDATE member
        SET name                 = #{name},
            phone                = #{phone},
            relation             = #{relation},
            notify_weekly_report = #{notifyWeeklyReport},
            notify_reminder      = #{notifyReminder},
            agree_marketing      = #{agreeMarketing},
            updated_at           = #{updatedAt}
        WHERE login_id = #{loginId}
          AND deleted_at IS NULL
    </update>

    <!-- ================= 마이페이지: 계정 완전 삭제 =================
         화면 문구가 "모든 정보가 영구히 소멸되며 절대 복구할 수 없습니다" 이므로
         deleted_at 만 찍는 논리 삭제가 아니라 행을 실제로 지운다(2026-08-14 사용자 확정).
         ⚠ 되돌릴 수 없다. 테스트는 반드시 버려도 되는 계정으로 할 것.

         지우는 순서가 곧 외래키 순서다 — 위에서부터 실행해야 한다.
           story_session → story → child → member
         실제 DB 의 FK(information_schema 확인, 2026-08-14):
           · child → member          : ON DELETE 규칙 없음(RESTRICT) → child 가 남아 있으면 member 삭제 실패
           · story_session → story   : 규칙 없음(RESTRICT)          → story 를 먼저 지우면 실패
           · 그 밖(checklist·roadmap·emotion_stat·snapshot·expression_calib·story_node·mission_log)
             은 전부 CASCADE 라 부모만 지우면 따라 지워진다.
         대상은 login_id 가 아니라 member_id 로 잡는다 — 자식 테이블이 member_id·child_id 로 물려 있다. -->

    <!-- 1. 학습 세션 (mission_log 는 CASCADE) -->
    <delete id="deleteStorySessionByMember" parameterType="UserDTO">
        DELETE FROM story_session
        WHERE child_id IN (SELECT child_id FROM child WHERE member_id = #{memberId})
    </delete>

    <!-- 2. 이야기 (story_node 는 CASCADE) -->
    <delete id="deleteStoryByMember" parameterType="UserDTO">
        DELETE FROM story
        WHERE child_id IN (SELECT child_id FROM child WHERE member_id = #{memberId})
    </delete>

    <!-- 3. 아동 (checklist·roadmap·감정통계·스냅샷·표정보정은 CASCADE) -->
    <delete id="deleteChildByMember" parameterType="UserDTO">
        DELETE FROM child
        WHERE member_id = #{memberId}
    </delete>

    <!-- 4. 회원 본인. 여기까지 와야 아이디·이메일 UNIQUE 가 풀려 재가입할 수 있다 -->
    <delete id="deleteUser" parameterType="UserDTO">
        DELETE FROM member
        WHERE member_id = #{memberId}
    </delete>

</mapper>
